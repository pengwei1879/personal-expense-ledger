{
  "name": "personal-expense-ledger",
  "version": "0.1.0",
  "private": false,
  "description": "A local personal expense ledger with Express, built-in SQLite, CSV export, and a small web UI.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/db.js && node --check src/server.js",
    "lint": "eslint .",
    "test": "npm run check && npm run lint"
  },
  "keywords": [
    "expense-tracker",
    "sqlite",
    "express",
    "local-first",
    "personal-finance"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0"
  }
}
